diff --git a/Artifacts/CT-Implementation/bliss1_galactics/ref/randombytes.c b/Artifacts/CT-Implementation/bliss1_galactics/ref/randombytes.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/Artifacts/CT-Implementation/bliss1_galactics/ref/randombytes.c
@@ -0,0 +1,15 @@
+#include "randombytes.h"
+
+#include <stdint.h>
+
+void randombytes(unsigned char *buf, unsigned long long len)
+{
+    static uint64_t state = 0x6a09e667f3bcc909ULL;
+
+    for (unsigned long long i = 0; i < len; i++) {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        buf[i] = (unsigned char)(state >> 56);
+    }
+}
